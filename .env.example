# Kite MCP Server Environment Configuration
# ---------------------------------------
# This file contains all environment variables used by the Kite MCP Server.
# Copy this file to ".env" and update with your actual values.

# Required Kite Connect API credentials
# Register at https://developers.kite.trade/signup to obtain these
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# JWT OAuth Configuration (required)
# ----------------------------------
# JWT_SECRET: Secret key for signing JWT tokens (minimum 32 bytes)
#   - Generate with: openssl rand -hex 32
JWT_SECRET=your-32-byte-secret-key-for-jwt-signing

# OAUTH_ISSUER: OAuth issuer URL (optional)
#   - Defaults to http://{APP_HOST}:{APP_PORT} if not set
#   - Set to your public URL in production
# OAUTH_ISSUER=https://mcp.example.com
#
# ALLOWED_REDIRECT_PATTERNS: Comma-separated redirect URI allowlist patterns (optional)
#   - Defaults to localhost-only if unset
#   - Special token: localhost
#   - Exact HTTPS callback URIs are recommended for hosted clients
#   - prefix:... patterns are supported for trusted hosted providers with dynamic callback paths
#   - Example:
# ALLOWED_REDIRECT_PATTERNS=localhost,https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect,prefix:https://chatgpt.com/connector/oauth/

# Server configuration (optional - defaults shown)
# ------------------------------------------------
# APP_MODE: The communication mode for the server
#   - stdio: Standard input/output (best for Claude Desktop)
#   - http: HTTP mode (RESTful API) - default
#   - sse: Server-Sent Events over HTTP (best for web clients)
#   - hybrid: Combined mode with both SSE and MCP endpoints
APP_MODE=http

# Server network settings (only used in http, sse, and hybrid modes)
APP_PORT=8080        # Port to listen on (default: 8080)
APP_HOST=localhost   # Host to bind to (use 0.0.0.0 for all interfaces)
# OAUTH_TOKEN_TTL: OAuth access token lifetime (Go duration format)
#   - Default and maximum: 24h (must not outlive the Kite session)
# OAUTH_TOKEN_TTL=24h
# MCP_SESSION_TIMEOUT: Streamable HTTP MCP session lifetime (Go duration format)
#   - Default: 24h
# MCP_SESSION_TIMEOUT=24h
# ALLOWED_REDIRECT_PATTERNS=localhost
# TRUSTED_PROXY_CIDRS: Comma-separated CIDRs for the reverse proxies that
# terminate TLS and set X-Forwarded-For. Leave unset when the server is public.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,fd00::/8

# Tool exclusion (optional)
# -------------------------
# EXCLUDED_TOOLS: Comma-separated list of tools to exclude from registration
#   - Useful for creating read-only instances or removing destructive operations
#   - Tools are registered as groups. Use orders to exclude all order operations.
#   - Example: orders,gtt,alerts (excludes all trading operations)
#   - Leave empty to enable all tools
# EXCLUDED_TOOLS=orders,gtt,alerts

# Logging configuration (optional)
# --------------------------------
# LOG_LEVEL: Controls verbosity of logs
#   - debug: Verbose output for development
#   - info: Normal operational logs (default)
#   - warn: Only warning and error logs
#   - error: Only error logs
LOG_LEVEL=info
